# Copy to .env and fill in BOTH values. docker compose reads .env automatically
# and refuses to start if either is empty. Never commit .env.
#
#   cp .env.example .env

# Postgres password for the `nvr` database user.
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# Shared secret for the REST API, WebSocket and clip/thumbnail downloads.
# The API refuses to start if it is shorter than 16 characters.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# --- Optional ---------------------------------------------------------------
# Comma-separated browser origins allowed to call the API directly.
# Leave empty when using the bundled nginx frontend (same-origin).
# CORS_ORIGINS=

# Group id of /dev/video0 on the host (webcam testing on native Linux only).
# Find it with: stat -c '%g' /dev/video0
# VIDEO_GID=44
